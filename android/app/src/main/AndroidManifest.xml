<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Lokasi: hanya untuk arah kiblat & jadwal sholat. Pengguna boleh memakai lokasi manual. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Notifikasi: pengingat waktu sholat/adzan (Android 13+). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Penjadwalan pengingat + bertahan setelah reboot.
         Pengingat memakai WorkManager (bukan AlarmManager), jadi SCHEDULE_EXACT_ALARM /
         USE_EXACT_ALARM sengaja TIDAK dideklarasikan — izin alarm tepat waktu hanya muncul bila
         kode benar-benar memakai AlarmManager (lihat OfflineManifestTest).

         Aturan umumnya: izin hanya diminta bila benar-benar dipakai kode aplikasi sendiri —
         dijaga `PemakaianIzinTest`. Karena itu WAKE_LOCK sengaja TIDAK ada di sini: tak satu pun
         kode aplikasi memakai PowerManager/WakeLock. Pustaka yang memang membutuhkannya
         menyatakannya di manifesnya sendiri (WorkManager mencantumkan WAKE_LOCK), sehingga izin
         itu tetap ada di manifes gabungan tanpa aplikasi ikut memintanya. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Pemutaran adzan di latar belakang (foreground service media). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!-- Getar singkat saat timer iqomah berakhir. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Opsional: agar pengguna dapat mengecualikan pengingat dari mode Jangan Ganggu (DND).
         Pemberian akses dilakukan pengguna di Pengaturan sistem, bukan oleh aplikasi. -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />

    <!-- INTERNET: hanya untuk murottal Surat Yasin — streaming per ayat yang dimulai pengguna
         sendiri dari layar Yasin (pemakaiannya terkunci di paket core/audio, lihat OfflineManifestTest).
         Seluruh perhitungan dan konten tetap offline; aplikasi tidak pernah memeriksa status jaringan
         sehingga ACCESS_NETWORK_STATE tetap tidak dideklarasikan. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <uses-feature android:name="android.hardware.sensor.compass" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />

    <application
        android:name=".YasinApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.YasinTahlil"
        android:allowBackup="true"
        android:supportsRtl="true">
        <!-- singleTop: ketukan notifikasi saat aplikasi sudah terbuka diteruskan lewat onNewIntent,
             sehingga rute tujuan dibuka pada instance yang sama (bukan menumpuk layar). -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- WorkManager diinisialisasi on-demand lewat YasinApp.Configuration.Provider (HiltWorkerFactory). -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!-- Tipe layanan foreground untuk pemutaran adzan (wajib sejak Android 14/targetSdk 34). -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="mediaPlayback"
            tools:node="merge" />

        <!-- Susun ulang pengingat setelah reboot / pembaruan aplikasi. -->
        <receiver
            android:name=".core.scheduling.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Widget jadwal sholat 4x3 di layar utama: RemoteViews klasik (tanpa dependensi baru),
             seluruh hisab dihitung offline di perangkat, tanpa izin tambahan apa pun.
             exported="false" sesuai templat dokumentasi Android modern untuk APPWIDGET_UPDATE:
             sistem tetap dapat mengirim siaran ke receiver yang tidak diekspor. -->
        <receiver
            android:name="id.or.kemenag.yasintahlil.widget.WidgetJadwalProvider"
            android:exported="false"
            android:label="Jadwal sholat">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_jadwal_info" />
        </receiver>

        <!-- Kartu bacaan yang dibagikan sebagai gambar: PNG di cache diteruskan lewat FileProvider
             (content:// URI) — berkas di cache sendiri tidak dapat dibagikan langsung sejak API 24. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
