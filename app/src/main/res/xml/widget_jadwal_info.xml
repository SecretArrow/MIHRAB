<?xml version="1.0" encoding="utf-8"?>
<!-- Metadata widget jadwal sholat (dibaca pemilih widget & AppWidgetService).

     updatePeriodMillis 30 menit adalah nilai TERKECIL yang diizinkan sistem — sistem menolak
     nilai di bawahnya dan memakai 30 menit. Jam sholat hanya berganti beberapa kali sehari dan
     tanggalnya sekali, dan setiap pembaruan menghitung ulang jadwal untuk hari berjalan, jadi
     lebih sering hanya menghabiskan baterai. targetCellWidth/Height & description dikenal
     sejak API 31; perangkat lebih lama mengabaikannya tanpa galat karena atribut yang tak
     dikenal dalam berkas resource memang dilewati. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="180dp"
    android:targetCellWidth="4"
    android:targetCellHeight="3"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/widget_jadwal"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:description="@string/widget_jadwal_deskripsi" />
