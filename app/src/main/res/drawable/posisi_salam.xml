<?xml version="1.0" encoding="utf-8"?>
<!--
  Skema posisi salam: duduk tasyahud akhir, wajah menoleh ke kanan lalu ke kiri
  (busur panah menandakan arah tolehan).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="100dp"
    android:height="100dp"
    android:viewportWidth="100"
    android:viewportHeight="100">
    <!-- kepala (menoleh ke samping) -->
    <path
        android:pathData="M52,28 a8,8 0 1 0 16,0 a8,8 0 1 0 -16,0 z"
        android:fillColor="#00000000"
        android:strokeColor="#0B7A55"
        android:strokeWidth="4.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <!-- badan tegak -->
    <path
        android:pathData="M50,36 L50,62"
        android:fillColor="#00000000"
        android:strokeColor="#0B7A55"
        android:strokeWidth="4.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <!-- paha ke depan lalu betis terlipat -->
    <path
        android:pathData="M50,62 L72,70 M72,70 L60,86"
        android:fillColor="#00000000"
        android:strokeColor="#0B7A55"
        android:strokeWidth="4.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <!-- kedua tangan di atas paha -->
    <path
        android:pathData="M50,42 L64,64 M50,44 L58,66"
        android:fillColor="#00000000"
        android:strokeColor="#0B7A55"
        android:strokeWidth="4.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <!-- busur arah tolehan -->
    <path
        android:pathData="M76,20 Q86,28 78,38"
        android:fillColor="#00000000"
        android:strokeColor="#0B7A55"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <!-- garis lantai -->
    <path
        android:pathData="M14,88 L86,88"
        android:fillColor="#00000000"
        android:strokeColor="#0B7A55"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
