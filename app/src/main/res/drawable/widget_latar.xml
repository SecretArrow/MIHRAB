<?xml version="1.0" encoding="utf-8"?>
<!-- Latar widget jadwal: zamrud gelap dari palet aplikasi (@color/zamrud_gelap, #063D2B —
     ujung keluarga zamrud yang ditampilkan TemaAplikasi dan diuji kontrasnya terhadap teks
     putih di ContrastTest), dengan sudut membulat sesuai kelengkungan kartu aplikasi
     (Shapes.large 24dp; sedikit lebih kecil di sini karena widget 4x3 lebih rapat). Teks
     putih/gading di atasnya memakai pasangan warna yang sama dengan kartu waktu sholat
     berikutnya di beranda (GradienZamrud + teks putih). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/zamrud_gelap" />
    <corners android:radius="20dp" />
</shape>
